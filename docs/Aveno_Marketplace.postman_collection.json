        {
          "name": "Show category (with attributes)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/categories/{{category_id}}", "host": ["{{base_url}}"], "path": ["categories", "{{category_id}}"] }
          }
        }
      ]
    },
    {
      "name": "Ads",
      "item": [
        {
          "name": "Browse ads (public feed)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/ads?category_id=&governorate_id=&city_id=&min_price=&max_price=&q=&sort=&lat=&lng=",
              "host": ["{{base_url}}"], "path": ["ads"],
              "query": [
                { "key": "category_id", "value": "" },
                { "key": "governorate_id", "value": "" },
                { "key": "city_id", "value": "" },
                { "key": "min_price", "value": "" },
                { "key": "max_price", "value": "" },
                { "key": "q", "value": "" },
                { "key": "sort", "value": "", "description": "newest (default) | price_asc | price_desc | popular | nearest" },
                { "key": "lat", "value": "", "description": "required only if sort=nearest" },
                { "key": "lng", "value": "", "description": "required only if sort=nearest" }
              ]
            }
          }
        },
        {
          "name": "Show ad detail",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/ads/{{ad_id}}", "host": ["{{base_url}}"], "path": ["ads", "{{ad_id}}"] }
          }
        },
        {
          "name": "My ads",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/my/ads", "host": ["{{base_url}}"], "path": ["my", "ads"] }
          }
        },
        {
          "name": "My ads — stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/my/ads/stats", "host": ["{{base_url}}"], "path": ["my", "ads", "stats"] }
          }
        },
        {
          "name": "Similar ads",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/ads/{{ad_id}}/similar", "host": ["{{base_url}}"], "path": ["ads", "{{ad_id}}", "similar"] }
          }
        },
        {
          "name": "Create ad",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "category_id", "value": "1", "type": "text" },
                { "key": "governorate_id", "value": "1", "type": "text" },
                { "key": "city_id", "value": "1", "type": "text" },
                { "key": "title", "value": "Kia Sportage 2020", "type": "text" },
                { "key": "description", "value": "Well maintained, single owner.", "type": "text" },
                { "key": "price", "value": "15000", "type": "text" },
                { "key": "currency", "value": "USD", "type": "text" },
                { "key": "attributes[condition]", "value": "مستعملة", "type": "text" },
                { "key": "attributes[year]", "value": "2020", "type": "text" },
                { "key": "images[]", "type": "file", "src": [] }
              ]
            },
            "url": { "raw": "{{base_url}}/ads", "host": ["{{base_url}}"], "path": ["ads"] }
          }
        },
        {
          "name": "Update ad",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Updated title\",\n  \"price\": 14000\n}" },
            "url": { "raw": "{{base_url}}/ads/{{ad_id}}", "host": ["{{base_url}}"], "path": ["ads", "{{ad_id}}"] }
          }
        },
        {
          "name": "Delete ad",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/ads/{{ad_id}}", "host": ["{{base_url}}"], "path": ["ads", "{{ad_id}}"] }
          }
        },
        {
          "name": "Add photos to ad",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "images[]", "type": "file", "src": [] }]
            },
            "url": { "raw": "{{base_url}}/ads/{{ad_id}}/images", "host": ["{{base_url}}"], "path": ["ads", "{{ad_id}}", "images"] }
          }
        },
        {
          "name": "Remove a photo from ad",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/ads/{{ad_id}}/images/{{image_id}}", "host": ["{{base_url}}"], "path": ["ads", "{{ad_id}}", "images", "{{image_id}}"] }
          }
        },
        {
          "name": "Mark ad as sold",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/ads/{{ad_id}}/mark-sold", "host": ["{{base_url}}"], "path": ["ads", "{{ad_id}}", "mark-sold"] }
          }
        },
        {
          "name": "Relist a sold/expired ad",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/ads/{{ad_id}}/relist", "host": ["{{base_url}}"], "path": ["ads", "{{ad_id}}", "relist"] }
          }
        },
        {
          "name": "Report an ad",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"scam\",\n  \"details\": \"Asked for payment outside the app\"\n}" },
            "url": { "raw": "{{base_url}}/ads/{{ad_id}}/report", "host": ["{{base_url}}"], "path": ["ads", "{{ad_id}}", "report"] }
          }
        }
      ]
    },
