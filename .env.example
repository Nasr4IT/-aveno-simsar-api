APP_NAME="Aveno Marketplace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Damascus
APP_URL=http://localhost:8000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aveno_marketplace
DB_USERNAME=root
DB_PASSWORD=

# --- Sessions / Cache / Queue ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log
# --- File storage ---
# 'public' = local disk (default; fine for dev, but not persistent on
# hosts without a persistent volume — e.g. Render's free tier wipes it on
# every restart). Set to 's3' + the AWS_* vars below to use any
# S3-compatible bucket instead — including Cloudflare R2, which is
# S3-API-compatible: set AWS_ENDPOINT to R2's endpoint URL,
# AWS_DEFAULT_REGION=auto, AWS_USE_PATH_STYLE_ENDPOINT=true, and
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/AWS_BUCKET/AWS_URL from the R2
# bucket + API token. See docs/HOW_IT_WORKS.md § Persistent Image Storage.
FILESYSTEM_DISK=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Mail (used for ad-review / notification emails) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@avenocode-marketplace.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Sanctum (mobile app token auth) ---
SANCTUM_STATEFUL_DOMAINS=localhost
SANCTUM_TOKEN_EXPIRATION_MINUTES=525600

# --- Google Maps (geo search / map results) ---
GOOGLE_MAPS_API_KEY=

# --- Sham Cash payment gateway (featured-ad packages) ---
SHAMCASH_BASE_URL=https://api.shamcash.example/v1
SHAMCASH_MERCHANT_ID=
SHAMCASH_API_KEY=
SHAMCASH_API_SECRET=
SHAMCASH_WEBHOOK_SECRET=
SHAMCASH_CALLBACK_URL="${APP_URL}/api/payments/shamcash/webhook"

# --- Firebase (push notifications via FCM HTTP v1) ---
# Full service-account JSON (Firebase console > Project settings > Service
# accounts > Generate new private key), as one line. Blank = push
# notifications silently no-op (PushNotificationService) — in-app/database
# notifications (GET /notifications) work regardless either way.
FIREBASE_CREDENTIALS_JSON=

# --- Error tracking (Sentry) ---
# Blank = disabled entirely (the SDK's own behavior). Get a DSN free at
# sentry.io.
SENTRY_LARAVEL_DSN=
