APP_NAME="Aveno Marketplace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Damascus
APP_URL=http://localhost:8000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aveno_marketplace
DB_USERNAME=root
DB_PASSWORD=

# --- Sessions / Cache / Queue ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Mail (used for ad-review / notification emails) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@avenocode-marketplace.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Sanctum (mobile app token auth) ---
SANCTUM_STATEFUL_DOMAINS=localhost
SANCTUM_TOKEN_EXPIRATION_MINUTES=525600

# --- Google Maps (geo search / map results) ---
GOOGLE_MAPS_API_KEY=

# --- Sham Cash payment gateway (featured-ad packages) ---
SHAMCASH_BASE_URL=https://api.shamcash.example/v1
SHAMCASH_MERCHANT_ID=
SHAMCASH_API_KEY=
SHAMCASH_API_SECRET=
SHAMCASH_WEBHOOK_SECRET=
SHAMCASH_CALLBACK_URL="${APP_URL}/api/payments/shamcash/webhook"

# --- Firebase (push notifications - Phase 2) ---
FIREBASE_SERVER_KEY=
